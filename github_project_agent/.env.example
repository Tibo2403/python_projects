# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# GitHub
# Option 1: connecte-toi avec `gh auth login` et laisse GITHUB_TOKEN vide.
# Option 2: mets un personal access token avec droits repo/workflow selon tes besoins.
GITHUB_TOKEN=

# Repertoire local ou l'agent clone les projets.
AGENT_WORKSPACE=.agent-workspace
